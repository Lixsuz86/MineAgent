{
  "name": "mc-ai-agent-desktop",
  "version": "1.0.0",
  "description": "Minecraft AI Agent - Masaüstü Kurulum ve Kontrol Uygulaması",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.mcaiagent.desktop",
    "productName": "MC AI Agent",
    "files": [
      "src/**/*",
      "core/**/*",
      "!core/node_modules/**/test/**",
      "!core/node_modules/**/*.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MC AI Agent"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
