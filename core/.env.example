# Kullandığınız sağlayıcıya göre ilgili satırı doldurun.
# İkisini de doldurmanıza gerek yok — sadece config.json'da seçtiğiniz sağlayıcının key'i gerekli.

# https://console.groq.com adresinden ücretsiz alınır
GROQ_API_KEY=

# https://aistudio.google.com/apikey adresinden ücretsiz alınır
GEMINI_API_KEY=

# https://elevenlabs.io adresinden ücretsiz kotayla alınır (ses katmanı için, opsiyonel)
ELEVENLABS_API_KEY=
